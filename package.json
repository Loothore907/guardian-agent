{
  "name": "agentic-guardian",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "build": "tsc -b --pretty false && vite build --config apps/web/vite.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:sqlite-spike && pnpm test:demo-reset-plan && pnpm boundaries && pnpm build",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,json}\" \".github/**/*.{json,yaml,yml}\" \"*.{ts,js,cjs,json,yaml,yml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,json}\" \".github/**/*.{json,yaml,yml}\" \"*.{ts,js,cjs,json,yaml,yml}\"",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"*.ts\" --max-warnings=0",
    "start:control-api": "node apps/control-api/dist/main.js",
    "start:guardian": "node apps/guardian-cli/dist/main.js start",
    "start:authority-service": "node apps/authority-service/dist/main.js",
    "start:interaction-service": "node apps/interaction-service/dist/main.js",
    "start:worker-service": "node apps/worker-service/dist/main.js",
    "start:research-service": "node apps/research-service/dist/main.js",
    "start:session-host": "node apps/session-host/dist/main.js",
    "test": "vitest run",
    "test:live:tavily": "pnpm build && node --test scripts/tavily-live.test.mjs",
    "test:live:assembled-no-effect": "pnpm build && node --test scripts/assembled-no-effect-live.test.mjs",
    "test:live:credentials": "node --env-file=.env.local node_modules/vitest/vitest.mjs run packages/credential-verification/src/live.integration.test.ts",
    "test:live:nebius-models": "pnpm build && node --test scripts/nebius-models-live.test.mjs",
    "test:live:nemotron-broker": "pnpm build && node --test scripts/nemotron-broker-live.test.mjs",
    "test:live:native-worker": "pnpm build && node --test scripts/native-worker-live.test.mjs",
    "test:live:native-worker-capabilities": "pnpm build && node scripts/nebius-worker-capability-probe.mjs",
    "test:live:native-worker-denial": "pnpm build && node --test scripts/native-worker-denial-live.test.mjs",
    "test:live:native-worker-tool": "pnpm build && node --test scripts/native-worker-tool-live.test.mjs",
    "test:live:qwen": "pnpm build && node --test scripts/qwen-live.test.mjs",
    "test:demo-reset-plan": "node --test scripts/demo-reset-plan.test.mjs",
    "test:linux-platform": "node --test scripts/linux-c6-permissions.test.mjs",
    "test:reference-runtime": "pnpm build && node --test scripts/reference-runtime.test.mjs",
    "test:sqlite-spike": "node --test spikes/sqlite-authority/spike.test.mjs",
    "test:session-enforcement": "node --test spikes/enforced-session/spike.test.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
