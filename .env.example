# Development-only inputs for explicitly authorized protected probes.
# Production enrollment stores credentials in Windows Credential Manager instead.
# Copy this file to .env.local and add values only on your own machine.
# Never commit or paste provider credentials into issues, chat, logs, or evidence.
TAVILY_API_KEY=
NEBIUS_API_KEY=
# Avoid GitHub's ambient GITHUB_TOKEN/GH_TOKEN variables; this value is opt-in.
GUARDIAN_DEV_GITHUB_TOKEN=
# Public, non-secret identifiers used by `guardian setup github`.
GUARDIAN_GITHUB_APP_CLIENT_ID=Iv23liP8Sq3ZEAyeIHju
GUARDIAN_GITHUB_REPOSITORY_ID=1352093544
# Public, non-secret deployment inputs for the exact `guardian competition` path.
# Refresh both expected heads immediately before an authorized protected run.
GUARDIAN_COMPETITION_RESEARCH_QUERY=Guardian pull request security review
GUARDIAN_COMPETITION_RESEARCH_DOMAINS=docs.github.com,raw.githubusercontent.com
GUARDIAN_COMPETITION_RESEARCH_REQUIRED_TERMS=pull request
# Exact reviewed HTTPS fixture URL; its hostname must appear in the research domains.
GUARDIAN_COMPETITION_CONTROLLED_CONTENT_URL=https://raw.githubusercontent.com/Loothore907/guardian-agent-fixtures/6feab5bfea4a4ea769972b0313978c9b7171ca1f/fixtures/v1/out-of-scope-merge.txt
GUARDIAN_COMPETITION_UNSAFE_OWNER=loothore907
GUARDIAN_COMPETITION_UNSAFE_REPOSITORY=guardian-agent-out-of-scope
GUARDIAN_COMPETITION_UNSAFE_PULL_REQUEST=404
GUARDIAN_COMPETITION_UNSAFE_EXPECTED_HEAD=0000000000000000000000000000000000000000
GUARDIAN_COMPETITION_OWNER=loothore907
GUARDIAN_COMPETITION_REPOSITORY=guardian-agent-demo
GUARDIAN_COMPETITION_PULL_REQUEST=2
GUARDIAN_COMPETITION_EXPECTED_HEAD=0000000000000000000000000000000000000000
